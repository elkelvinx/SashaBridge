<resources>
    <!-- Wine and coat-brown theme; the night variants of the colors switch it to dark. -->
    <style name="Base.Theme.SashaBridge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/coat</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorTertiary">@color/coat_tan</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_muted</item>
        <item name="colorOutline">@color/outline</item>
        <!-- Tonal buttons (Cola, Dar acceso, Abrir ajustes) in the app's palette, not Material's. -->
        <item name="colorSecondaryContainer">@color/surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/on_surface</item>
    </style>

    <style name="Theme.SashaBridge" parent="Base.Theme.SashaBridge" />

    <!-- The annotation screen is always dark, so the capture stands out in either theme. -->
    <style name="Theme.SashaBridge.Annotate">
        <item name="android:windowBackground">@color/annotate_background</item>
    </style>

    <!-- Rounded cards with a hairline border instead of a shadow. -->
    <style name="Widget.SashaBridge.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="ShapeAppearance.SashaBridge.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Small covers of the lists, such as the play queue. -->
    <style name="ShapeAppearance.SashaBridge.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Borderless icon button of the player controls. -->
    <style name="Widget.SashaBridge.ControlButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">8dp</item>
        <item name="tint">@color/on_surface</item>
    </style>

    <!-- Larger buttons beside the album art to skip tracks. -->
    <style name="Widget.SashaBridge.SkipButton" parent="Widget.SashaBridge.ControlButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">6dp</item>
    </style>

    <!-- One line of text that scrolls when it does not fit; the code selects the view. -->
    <style name="Widget.SashaBridge.Marquee" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
    </style>

    <!-- Times next to the seek bar: digits of equal width, so they do not jump. -->
    <style name="TextAppearance.SashaBridge.Time" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TextAppearance.SashaBridge.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- "Anotar" on the main screen: a tonal pill with the pen, its icon in the wine accent. -->
    <style name="Widget.SashaBridge.AnnotateButton" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="android:layout_height">48dp</item>
        <item name="android:text">@string/button_annotate</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="icon">@drawable/ic_edit</item>
        <item name="iconTint">@color/accent_text</item>
        <item name="iconPadding">12dp</item>
    </style>

    <!-- The same, tighter, for the narrow left column of the landscape display. -->
    <style name="Widget.SashaBridge.AnnotateButton.Compact">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- Square tool button of the annotation bars; selected tools get a wine pill. -->
    <style name="Widget.SashaBridge.AnnotateTool" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/tool_background</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">10dp</item>
        <item name="tint">@color/annotate_on_background</item>
    </style>

    <!-- Thin vertical rule between the groups of the annotation bar. -->
    <style name="Widget.SashaBridge.AnnotateDivider" parent="">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@color/annotate_muted</item>
    </style>
</resources>
