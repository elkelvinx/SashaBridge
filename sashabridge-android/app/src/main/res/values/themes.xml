<resources>
    <!-- Wine and coat-brown theme; the night variants of the colors switch it to dark. -->
    <style name="Base.Theme.SashaBridge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/coat</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorTertiary">@color/coat_tan</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_muted</item>
        <item name="colorOutline">@color/outline</item>
        <!-- Tonal buttons (Cola, Dar acceso, Abrir ajustes) in the app's palette, not Material's. -->
        <item name="colorSecondaryContainer">@color/surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/on_surface</item>
        <!-- Wine, the default accent; see attrs.xml. -->
        <item name="sashaAccent">@color/seek_thumb</item>
        <item name="sashaAccentPlayed">@color/seek_played</item>
        <item name="sashaAccentSoft">@color/accent_wine_soft</item>
    </style>

    <style name="Theme.SashaBridge" parent="Base.Theme.SashaBridge" />

    <!-- The other accents of Ajustes > Apariencia, laid over the theme of each screen. Wine is
         the theme itself, so it needs none. -->
    <style name="ThemeOverlay.SashaBridge.Accent.Wine" parent="" />

    <style name="ThemeOverlay.SashaBridge.Accent.Blue" parent="">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="sashaAccent">@color/accent_blue_strong</item>
        <item name="sashaAccentPlayed">@color/accent_blue_played</item>
        <item name="sashaAccentSoft">@color/accent_blue_soft</item>
    </style>

    <style name="ThemeOverlay.SashaBridge.Accent.Green" parent="">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="sashaAccent">@color/accent_green_strong</item>
        <item name="sashaAccentPlayed">@color/accent_green_played</item>
        <item name="sashaAccentSoft">@color/accent_green_soft</item>
    </style>

    <style name="ThemeOverlay.SashaBridge.Accent.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="sashaAccent">@color/accent_purple_strong</item>
        <item name="sashaAccentPlayed">@color/accent_purple_played</item>
        <item name="sashaAccentSoft">@color/accent_purple_soft</item>
    </style>

    <style name="ThemeOverlay.SashaBridge.Accent.Amber" parent="">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="sashaAccent">@color/accent_amber_strong</item>
        <item name="sashaAccentPlayed">@color/accent_amber_played</item>
        <item name="sashaAccentSoft">@color/accent_amber_soft</item>
    </style>

    <style name="ThemeOverlay.SashaBridge.Accent.Pink" parent="">
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="sashaAccent">@color/accent_pink_strong</item>
        <item name="sashaAccentPlayed">@color/accent_pink_played</item>
        <item name="sashaAccentSoft">@color/accent_pink_soft</item>
    </style>

    <!-- The annotation screen is always dark, so the capture stands out in either theme. -->
    <style name="Theme.SashaBridge.Annotate">
        <item name="android:windowBackground">@color/annotate_background</item>
    </style>

    <!-- Rounded cards with a hairline border instead of a shadow. -->
    <style name="Widget.SashaBridge.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Rows of the settings screen: a heading per card, choices and switches, and the
         muted line under each, indented under the text of a choice. -->
    <style name="Widget.SashaBridge.SettingsHeading" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Widget.SashaBridge.SettingsLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- One choice of a row of choices that fill the card's width, such as the theme. -->
    <style name="Widget.SashaBridge.SettingsSegment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- "Vista previa" row of the settings: touching it unfolds or folds an example. -->
    <style name="Widget.SashaBridge.PreviewHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.SashaBridge.PreviewTitle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Arrow of the "Vista previa" row; the code turns it up while the example shows. -->
    <style name="Widget.SashaBridge.PreviewChevron" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_expand_more</item>
        <item name="tint">@color/on_surface_muted</item>
    </style>

    <!-- A mode icon of the color example, as it looks when the mode is on. -->
    <style name="Widget.SashaBridge.PreviewIcon" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="tint">?attr/sashaAccent</item>
    </style>

    <!-- A setting chosen on a scale from 0 to 100, with words at its ends instead of numbers. -->
    <style name="Widget.SashaBridge.SettingsSlider" parent="Widget.Material3.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:valueFrom">0</item>
        <item name="android:valueTo">100</item>
        <item name="android:stepSize">5</item>
        <item name="labelBehavior">gone</item>
        <!-- A dot per step would crowd the track: 20 of them. -->
        <item name="tickVisible">false</item>
    </style>

    <style name="Widget.SashaBridge.SliderEnds" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

    <style name="Widget.SashaBridge.SliderEnd" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">@color/on_surface_muted</item>
    </style>

    <!-- Round accent swatch of the settings; the chosen one carries a check mark. -->
    <style name="Widget.SashaBridge.AccentSwatch" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/color_swatch</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">6dp</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="Widget.SashaBridge.SettingsDetail" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">36dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/on_surface_muted</item>
    </style>

    <style name="Widget.SashaBridge.SettingsChoice" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Widget.SashaBridge.SettingsSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="ShapeAppearance.SashaBridge.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Small covers of the lists, such as the play queue. -->
    <style name="ShapeAppearance.SashaBridge.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Borderless icon button of the player controls. -->
    <style name="Widget.SashaBridge.ControlButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">8dp</item>
        <item name="tint">@color/on_surface</item>
    </style>

    <!-- Larger buttons beside the album art to skip tracks. -->
    <style name="Widget.SashaBridge.SkipButton" parent="Widget.SashaBridge.ControlButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">6dp</item>
    </style>

    <!-- One line of text that scrolls when it does not fit; the code selects the view. -->
    <style name="Widget.SashaBridge.Marquee" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
    </style>

    <!-- Times next to the seek bar: digits of equal width, so they do not jump. -->
    <style name="TextAppearance.SashaBridge.Time" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TextAppearance.SashaBridge.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- "Anotar" on the main screen: a tonal pill with the pen, its icon in the wine accent. -->
    <style name="Widget.SashaBridge.AnnotateButton" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="android:layout_height">48dp</item>
        <item name="android:text">@string/button_annotate</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="icon">@drawable/ic_edit</item>
        <item name="iconTint">@color/accent_text</item>
        <item name="iconPadding">12dp</item>
    </style>

    <!-- The same, tighter, for the narrow left column of the landscape display. -->
    <style name="Widget.SashaBridge.AnnotateButton.Compact">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- Square tool button of the annotation bars; selected tools get a wine pill. -->
    <style name="Widget.SashaBridge.AnnotateTool" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/tool_background</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">10dp</item>
        <item name="tint">@color/annotate_on_background</item>
    </style>

    <!-- Thin vertical rule between the groups of the annotation bar. -->
    <style name="Widget.SashaBridge.AnnotateDivider" parent="">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@color/annotate_muted</item>
    </style>
</resources>
