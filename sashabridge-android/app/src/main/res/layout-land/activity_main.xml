<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen in landscape, a display to leave on next to the PC: the bridge on the left,
     the player, which matters most, on the right, both as tall as the screen. The status bar
     is hidden (the status card shows the battery and the time instead). The on/off button and
     the connection footer stay hidden here, so turning the phone into a "now playing" display
     cannot switch the bridge off by accident; both are in portrait. The scroll only matters
     when the battery warning does not fit. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- The two columns share the width by weight and the status card takes the height left in
         its column: two weights deep, on a screen this small that costs nothing noticeable. -->
    <LinearLayout
        android:id="@+id/mainContent"
        tools:ignore="InconsistentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.34"
            android:orientation="vertical"
            tools:ignore="NestedWeights">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/tagline"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/on_surface_muted" />

            <include
                layout="@layout/card_status"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include layout="@layout/card_battery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- The two S Pen screens, side by side. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/annotateButton"
                    style="@style/Widget.SashaBridge.AnnotateButton.Compact"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabletButton"
                    style="@style/Widget.SashaBridge.AnnotateButton.Compact"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/button_tablet"
                    app:icon="@drawable/ic_tablet" />
            </LinearLayout>

            <TextView
                android:id="@+id/footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <include
            layout="@layout/card_player"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="0.66" />
    </LinearLayout>
</ScrollView>
