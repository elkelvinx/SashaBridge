<?xml version="1.0" encoding="utf-8"?>
<!-- Status of the bridge in landscape: the text on top and Sasha, larger, in the space left
     below it, since the card takes the height of the column. Same views and ids as the
     portrait card in layout/card_status.xml. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.SashaBridge.Card"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_status"
            android:textAppearance="@style/TextAppearance.SashaBridge.Label" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/on_surface"
                tools:text="PC conectada" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_muted"
            tools:text="Las teclas multimedia de la PC controlan este teléfono." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantAccessButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/button_grant_access"
            android:visibility="gone" />

        <!-- 2.5dp per sprite pixel; the hourglass sits on the same grid. The spaces center her
             in whatever height the text leaves. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/sasha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                tools:src="@drawable/sasha_awake" />

            <ImageView
                android:id="@+id/hourglass"
                android:layout_width="27.5dp"
                android:layout_height="27.5dp"
                android:layout_gravity="end|bottom"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/hourglass"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
