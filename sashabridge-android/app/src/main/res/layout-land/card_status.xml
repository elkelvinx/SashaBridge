<?xml version="1.0" encoding="utf-8"?>
<!-- Status of the bridge in landscape, where the status bar is hidden: the battery and the time
     share the first line with the label, then the state, and Sasha, larger, in the space left
     below it. Same views and ids as the portrait card in layout/card_status.xml, plus the
     battery. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.SashaBridge.Card"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- "ESTADO", then the battery and the clock that the hidden status bar would show. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_status"
                android:textAppearance="@style/TextAppearance.SashaBridge.Label" />

            <TextView
                android:id="@+id/batteryLabel"
                tools:ignore="InconsistentLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:fontFeatureSettings="tnum"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/on_surface_muted"
                tools:drawableStart="@drawable/ic_bolt"
                tools:text="67 %" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFeatureSettings="tnum"
                android:format12Hour="@string/clock_format_12"
                android:format24Hour="@string/clock_format_24"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/on_surface" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/on_surface"
                tools:text="PC conectada" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_muted"
            tools:text="Las teclas multimedia de la PC controlan este teléfono." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantAccessButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/button_grant_access"
            android:visibility="gone" />

        <!-- 3dp per sprite pixel. The spaces center her in whatever height the text leaves. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <io.github.elkelvinx.sashabridge.ui.SashaView
            android:id="@+id/sasha"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
