<?xml version="1.0" encoding="utf-8"?>
<!-- Player card in landscape, as tall as the screen and readable at a glance. The art, what
     stands out most, is as tall as the row it shares with the details. The details start with
     "Sonando" over the queue button and the app icon at the end; then the track, its title
     large and shrinking to fit (PlayerCard), its artist scrolling; and at the bottom the
     controls: shuffle and repeat together and the heart on their own row, over previous, play
     and next. Every height here is counted so that the whole column fits the card, which is
     about 290 dp tall on a phone in landscape: an overflowing column squeezes its views and
     makes the track change jump. The seek bar runs along the whole card. Same views and ids as the portrait
     card in layout/card_player.xml, plus the two control groups. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.SashaBridge.Card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:contentPadding="0dp">

    <!-- The blurred art and its veil take the height of the content, never more. -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/coverBackdrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/playerContent"
            android:layout_alignBottom="@+id/playerContent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/playerContent"
            android:layout_alignBottom="@+id/playerContent"
            android:background="@drawable/player_scrim" />

        <LinearLayout
            android:id="@+id/playerContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal"
                tools:ignore="NestedWeights">

                <!-- The art's own area: a track change slides the art out of it and in, cut at
                     its edges, so the art never passes over the title. The padding leaves room
                     for the shadow. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="4dp">

                    <!-- As tall as the row, never so wide that the details lack room. -->
                    <io.github.elkelvinx.sashabridge.ui.SquareImageView
                        android:id="@+id/cover"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:elevation="6dp"
                        android:importantForAccessibility="no"
                        android:maxWidth="272dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/cover_placeholder"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.SashaBridge.Cover" />
                </FrameLayout>

                <!-- The track's text slides in a little from either side when the track
                     changes; it may cross the column's edge for that moment. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <!-- "Sonando" or "En pausa" over the queue; the player app at the end. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/playerLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_now_playing"
                                android:textAppearance="@style/TextAppearance.SashaBridge.Label" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/queueButton"
                                style="@style/Widget.Material3.Button.TonalButton.Icon"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginTop="2dp"
                                android:minHeight="0dp"
                                android:paddingVertical="0dp"
                                android:text="@string/button_queue"
                                android:visibility="gone"
                                app:icon="@drawable/ic_queue_music"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/appIcon"
                            android:contentDescription="@string/open_player_default"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:visibility="gone"
                            tools:src="@mipmap/ic_launcher"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/trackInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <!-- Large; PlayerCard shrinks it to fit one line, or two if it must. -->
                        <TextView
                            android:id="@+id/trackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:tag="@string/tag_fit_title"
                            android:textColor="@color/on_surface"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            tools:text="Lights Out" />

                        <TextView
                            android:id="@+id/trackArtist"
                            style="@style/Widget.SashaBridge.Marquee"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/on_surface_muted"
                            tools:text="VK Blanka" />

                        <TextView
                            android:id="@+id/trackSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/accent_text"
                            tools:text="en YouTube Music" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Shuffle and repeat together, and the heart, over the transport. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/modeGroup"
                                tools:ignore="InconsistentLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <ImageButton
                                    android:id="@+id/shuffleButton"
                                    android:padding="8dp"
                                    android:scaleType="fitCenter"
                                    style="@style/Widget.SashaBridge.ControlButton"
                                    android:layout_width="48dp"
                                    android:layout_height="44dp"
                                    android:contentDescription="@string/control_shuffle_off"
                                    android:src="@drawable/ic_shuffle"
                                    android:visibility="gone"
                                    tools:visibility="visible" />

                                <ImageButton
                                    android:id="@+id/repeatButton"
                                    android:padding="8dp"
                                    android:scaleType="fitCenter"
                                    style="@style/Widget.SashaBridge.ControlButton"
                                    android:layout_width="48dp"
                                    android:layout_height="44dp"
                                    android:contentDescription="@string/control_repeat"
                                    android:src="@drawable/ic_repeat"
                                    android:visibility="gone"
                                    tools:visibility="visible" />
                            </LinearLayout>

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:minWidth="12dp" />

                            <FrameLayout
                                android:id="@+id/likeGroup"
                                tools:ignore="InconsistentLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <ImageButton
                                    android:id="@+id/likeButton"
                                    android:padding="8dp"
                                    android:scaleType="fitCenter"
                                    style="@style/Widget.SashaBridge.ControlButton"
                                    android:layout_width="48dp"
                                    android:layout_height="44dp"
                                    android:contentDescription="@string/control_like"
                                    android:src="@drawable/ic_favorite_border" />
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/previousButton"
                                style="@style/Widget.SashaBridge.SkipButton"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:contentDescription="@string/control_previous"
                                android:src="@drawable/ic_skip_previous" />

                            <ImageButton
                                android:id="@+id/playPauseButton"
                                android:padding="16dp"
                                android:scaleType="fitCenter"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_marginHorizontal="14dp"
                                android:background="@drawable/play_button_background"
                                android:contentDescription="@string/control_play"
                                android:src="@drawable/ic_play"
                                app:tint="@color/on_primary" />

                            <ImageButton
                                android:id="@+id/nextButton"
                                style="@style/Widget.SashaBridge.SkipButton"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:contentDescription="@string/control_next"
                                android:src="@drawable/ic_skip_next" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Elapsed time, seek bar, duration, across the whole card. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/elapsedTime"
                    style="@style/TextAppearance.SashaBridge.Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="01:54" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/control_seek"
                    android:paddingHorizontal="14dp"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb"
                    tools:max="247000"
                    tools:progress="114000" />

                <TextView
                    android:id="@+id/durationTime"
                    style="@style/TextAppearance.SashaBridge.Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="04:07" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
