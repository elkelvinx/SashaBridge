<?xml version="1.0" encoding="utf-8"?>
<!-- Player card in landscape: the art on the left, everything else beside it. Same views and
     ids as the portrait card in layout/card_player.xml. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.SashaBridge.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:contentPadding="0dp">

    <!-- The blurred art and its veil take the height of the content, never more. -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/coverBackdrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/playerContent"
            android:layout_alignBottom="@+id/playerContent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/playerContent"
            android:layout_alignBottom="@+id/playerContent"
            android:background="@drawable/player_scrim" />

        <LinearLayout
            android:id="@+id/playerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <io.github.elkelvinx.sashabridge.ui.SquareImageView
                android:id="@+id/cover"
                android:layout_width="152dp"
                android:layout_height="wrap_content"
                android:elevation="6dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/cover_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SashaBridge.Cover" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- "Sonando" or "En pausa", and the icon of the player app. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    tools:ignore="UseCompoundDrawables">

                    <TextView
                        android:id="@+id/playerLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_now_playing"
                        android:textAppearance="@style/TextAppearance.SashaBridge.Label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/queueButton"
                        style="@style/Widget.Material3.Button.TonalButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:minHeight="0dp"
                        android:paddingVertical="0dp"
                        android:text="@string/button_queue"
                        android:visibility="gone"
                        app:icon="@drawable/ic_queue_music"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/appIcon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:visibility="gone"
                        tools:src="@mipmap/ic_launcher"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/trackInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/trackTitle"
                        style="@style/Widget.SashaBridge.Marquee"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold"
                        tools:text="It's Going Down Now" />

                    <TextView
                        android:id="@+id/trackArtist"
                        style="@style/Widget.SashaBridge.Marquee"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/on_surface_muted"
                        tools:text="Azumi Takahashi, Lotus Juice" />

                    <TextView
                        android:id="@+id/trackSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/accent_text"
                        tools:text="en Spotify" />
                </LinearLayout>

                <!-- Previous, play/pause, next, shuffle, repeat, queue. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/previousButton"
                        style="@style/Widget.SashaBridge.SkipButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/control_previous"
                        android:src="@drawable/ic_skip_previous" />

                    <ImageButton
                        android:id="@+id/playPauseButton"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/play_button_background"
                        android:contentDescription="@string/control_play"
                        android:src="@drawable/ic_play"
                        app:tint="@color/on_primary" />

                    <ImageButton
                        android:id="@+id/nextButton"
                        style="@style/Widget.SashaBridge.SkipButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/control_next"
                        android:src="@drawable/ic_skip_next" />

                    <ImageButton
                        android:id="@+id/shuffleButton"
                        style="@style/Widget.SashaBridge.ControlButton"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/control_shuffle_off"
                        android:src="@drawable/ic_shuffle"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/repeatButton"
                        style="@style/Widget.SashaBridge.ControlButton"
                        android:contentDescription="@string/control_repeat"
                        android:src="@drawable/ic_repeat"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

                <!-- Elapsed time, seek bar, duration. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/elapsedTime"
                        style="@style/TextAppearance.SashaBridge.Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="00:47" />

                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/control_seek"
                        android:paddingHorizontal="12dp"
                        android:splitTrack="false"
                        android:thumb="@drawable/seek_thumb"
                        tools:max="186000"
                        tools:progress="47000" />

                    <TextView
                        android:id="@+id/durationTime"
                        style="@style/TextAppearance.SashaBridge.Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="03:06" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
