<?xml version="1.0" encoding="utf-8"?>
<!-- An app of the statistics: its icon, its name (with "vídeo" for video apps), a bar of its
     share of the longest one, and its time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/statAppIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/statAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_surface"
            tools:text="YouTube Music" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/statAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="1000"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp"
            tools:progress="700" />
    </LinearLayout>

    <TextView
        android:id="@+id/statAppTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/on_surface_muted"
        tools:text="8 h 5 min" />
</LinearLayout>
