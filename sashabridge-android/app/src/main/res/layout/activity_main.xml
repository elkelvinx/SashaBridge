<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/tagline"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_muted" />

        <!-- Status, with Sasha showing it too. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SashaBridge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_status"
                    android:textAppearance="@style/TextAppearance.SashaBridge.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/status_dot" />

                            <TextView
                                android:id="@+id/statusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="@color/on_surface"
                                tools:text="PC conectada" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/on_surface_muted"
                            tools:text="Las teclas multimedia de la PC controlan este teléfono." />
                    </LinearLayout>

                    <!-- 2dp per sprite pixel; the hourglass sits on the same grid. -->
                    <FrameLayout
                        android:layout_width="104dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp">

                        <ImageView
                            android:id="@+id/sasha"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            tools:src="@drawable/sasha_awake" />

                        <ImageView
                            android:id="@+id/hourglass"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="end|bottom"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/hourglass"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </FrameLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/grantAccessButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/button_grant_access"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Track of the active player, with its controls and seek bar, over its blurred art. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SashaBridge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:contentPadding="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/coverBackdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/player_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- "Sonando" or "En pausa", and the icon of the player app. The icon is a
                         separate view because it has its own size and appears and disappears. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        tools:ignore="UseCompoundDrawables"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/playerLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_now_playing"
                            android:textAppearance="@style/TextAppearance.SashaBridge.Label" />

                        <ImageView
                            android:id="@+id/appIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:visibility="gone"
                            tools:src="@mipmap/ic_launcher"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Previous, album art, next. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/previousButton"
                            style="@style/Widget.SashaBridge.SkipButton"
                            android:contentDescription="@string/control_previous"
                            android:src="@drawable/ic_skip_previous" />

                        <io.github.elkelvinx.sashabridge.ui.SquareImageView
                            android:id="@+id/cover"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:elevation="6dp"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/cover_placeholder"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.SashaBridge.Cover" />

                        <ImageButton
                            android:id="@+id/nextButton"
                            style="@style/Widget.SashaBridge.SkipButton"
                            android:contentDescription="@string/control_next"
                            android:src="@drawable/ic_skip_next" />
                    </LinearLayout>

                    <!-- Track; long texts scroll like in Spotify. -->
                    <LinearLayout
                        android:id="@+id/trackInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/trackTitle"
                            style="@style/Widget.SashaBridge.Marquee"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold"
                            tools:text="It's Going Down Now" />

                        <TextView
                            android:id="@+id/trackArtist"
                            style="@style/Widget.SashaBridge.Marquee"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/on_surface_muted"
                            tools:text="Azumi Takahashi, Lotus Juice" />

                        <TextView
                            android:id="@+id/trackSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/accent_text"
                            tools:text="en Spotify" />
                    </LinearLayout>

                    <!-- Play/pause, shuffle, repeat, queue. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/playPauseButton"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/play_button_background"
                            android:contentDescription="@string/control_play"
                            android:src="@drawable/ic_play"
                            app:tint="@color/on_primary" />

                        <ImageButton
                            android:id="@+id/shuffleButton"
                            style="@style/Widget.SashaBridge.ControlButton"
                            android:layout_marginStart="12dp"
                            android:contentDescription="@string/control_shuffle_off"
                            android:src="@drawable/ic_shuffle"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <ImageButton
                            android:id="@+id/repeatButton"
                            style="@style/Widget.SashaBridge.ControlButton"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@string/control_repeat"
                            android:src="@drawable/ic_repeat"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/queueButton"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/button_queue"
                            android:visibility="gone"
                            app:icon="@drawable/ic_queue_music"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Elapsed time, seek bar, duration. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/elapsedTime"
                            style="@style/TextAppearance.SashaBridge.Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="00:47" />

                        <SeekBar
                            android:id="@+id/seekBar"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/control_seek"
                            android:paddingHorizontal="12dp"
                            android:splitTrack="false"
                            android:thumb="@drawable/seek_thumb"
                            tools:max="186000"
                            tools:progress="47000" />

                        <TextView
                            android:id="@+id/durationTime"
                            style="@style/TextAppearance.SashaBridge.Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="03:06" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shown only while Android may freeze the app in the background. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/batteryCard"
            style="@style/Widget.SashaBridge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/battery_detail"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/on_surface_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/batteryButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/button_battery" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/button_active"
            app:cornerRadius="18dp"
            tools:text="@string/button_turn_off" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/on_surface_muted"
            tools:text="USB · 127.0.0.1:8080 · protocolo v2" />
    </LinearLayout>
</ScrollView>
