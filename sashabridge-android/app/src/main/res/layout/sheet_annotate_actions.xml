<?xml version="1.0" encoding="utf-8"?>
<!-- What to do with the open capture, shown in a bottom sheet from the "+" of the annotation
     bar (or an accidental back gesture). Touching outside keeps annotating. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="20dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/annotate_actions_title"
        android:textAppearance="@style/TextAppearance.SashaBridge.Label" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sendAction"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/annotate_send"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/on_primary"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="18dp"
        app:icon="@drawable/ic_send"
        app:iconGravity="textStart"
        app:iconTint="@color/on_primary" />

    <TextView
        android:id="@+id/sendOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/annotate_send_offline"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/status_error"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/discardAction"
        style="@style/Widget.Material3.Button.TonalButton.Icon"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="@string/annotate_discard_capture"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:cornerRadius="18dp"
        app:icon="@drawable/ic_close"
        app:iconGravity="textStart" />
</LinearLayout>
