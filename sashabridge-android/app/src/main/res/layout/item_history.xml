<?xml version="1.0" encoding="utf-8"?>
<!-- One play of the history: its cover, title, artist and app, how many times in a row ("×3")
     and the time it played. The background is only the touch ripple. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    tools:ignore="Overdraw"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/historyCover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/cover_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.SashaBridge.Thumb" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_surface"
            tools:text="Lights Out" />

        <TextView
            android:id="@+id/historySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_muted"
            tools:text="VK Blanka · YouTube Music" />
    </LinearLayout>

    <TextView
        android:id="@+id/historyCount"
        style="@style/Widget.SashaBridge.CountBadge"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        tools:text="×3"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/historyTime"
        style="@style/TextAppearance.SashaBridge.Time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="14:32" />
</LinearLayout>
